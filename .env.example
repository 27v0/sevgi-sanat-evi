# Sanity CMS Bilgileri (sanity.io/manage adresinden alınabilir)
# Sanity projeniz henüz yoksa boş bırakabilirsiniz; site varsayılan verilerle sorunsuz açılır.
PUBLIC_SANITY_PROJECT_ID=dummy-project-id
PUBLIC_SANITY_DATASET=production

# (Opsiyonel) Canlı önizleme için API okuma token'ı
# SANITY_API_READ_TOKEN=

# Sitenin Alan Adı (Vercel'e eklediğiniz domain)
PUBLIC_SITE_URL=https://sevgisanatevi.com
