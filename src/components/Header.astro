---
import { defaultSiteSettings } from '../sanity/client';
---

<header class="w-full border-b border-stone-800/80 bg-stone-950/70 backdrop-blur-md sticky top-0 z-50 transition-all">
  {defaultSiteSettings.announcementBanner && (
    <div class="bg-gradient-to-r from-amber-600 via-amber-500 to-rose-600 py-1.5 px-4 text-center text-xs sm:text-sm font-medium text-stone-950 flex items-center justify-center gap-2 shadow-inner">
      <span>{defaultSiteSettings.announcementBanner}</span>
      <a href="#on-kayit" class="underline font-bold hover:text-white transition-colors ml-1">Kayıt Ol &rarr;</a>
    </div>
  )}

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
    <!-- Brand -->
    <a href="/" class="flex items-center gap-3.5 group">
      <div class="w-11 h-11 rounded-2xl bg-gradient-to-br from-amber-400 to-rose-500 p-0.5 shadow-lg shadow-amber-500/20 group-hover:scale-105 transition-transform duration-300">
        <div class="w-full h-full bg-stone-950 rounded-[14px] flex items-center justify-center text-amber-400">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <!-- Music note & paint palette fusion icon -->
            <path d="M9 18V5l12-2v13"></path>
            <circle cx="6" cy="18" r="3"></circle>
            <circle cx="18" cy="16" r="3"></circle>
          </svg>
        </div>
      </div>
      <div>
        <div class="text-xl sm:text-2xl font-black tracking-tight text-white flex items-center gap-1.5 font-serif-art">
          <span>Sevgi Sanat Evi</span>
        </div>
        <div class="text-xs font-medium text-amber-400/90 tracking-wider uppercase">
          Müzik & Resim Kursu
        </div>
      </div>
    </a>

    <!-- Nav actions -->
    <div class="flex items-center gap-3 sm:gap-4">
      <a
        href="#kurslar"
        class="hidden md:inline-flex text-sm font-medium text-stone-300 hover:text-amber-400 transition-colors px-3 py-2"
      >
        Branşlarımız
      </a>
      <a
        href="#neden-biz"
        class="hidden md:inline-flex text-sm font-medium text-stone-300 hover:text-amber-400 transition-colors px-3 py-2"
      >
        Hakkımızda
      </a>
      <a
        href="#sss"
        class="hidden md:inline-flex text-sm font-medium text-stone-300 hover:text-amber-400 transition-colors px-3 py-2"
      >
        S.S.S.
      </a>

      <!-- WhatsApp Quick Button -->
      <a
        href={`https://wa.me/${defaultSiteSettings.whatsapp}?text=${encodeURIComponent('Merhaba, Sevgi Sanat Evi müzik ve resim kursları hakkında bilgi ve ön kayıt almak istiyorum.')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-emerald-500/10 text-emerald-400 border border-emerald-500/25 text-xs sm:text-sm font-semibold hover:bg-emerald-500 hover:text-stone-950 transition-all duration-300 shadow-sm"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.102-.115.434-.506.549-.68.116-.173.232-.144.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824z"></path>
        </svg>
        <span class="hidden sm:inline">WhatsApp</span>
        <span class="sm:hidden">Mesaj</span>
      </a>

      <!-- Admin Panel Link -->
      <a
        href="/admin"
        class="inline-flex items-center gap-1.5 px-3 py-2 rounded-xl bg-stone-900 border border-stone-800 text-xs font-semibold text-stone-400 hover:text-white hover:border-stone-700 transition-colors"
        title="Sanity Yönetim Paneli"
      >
        <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
          <line x1="3" y1="9" x2="21" y2="9"></line>
          <line x1="9" y1="21" x2="9" y2="9"></line>
        </svg>
        <span>Panel</span>
      </a>
    </div>
  </div>
</header>
