---
import { defaultSiteSettings } from '../sanity/client';
---

<div class="glass-card rounded-3xl p-6 sm:p-10 border border-amber-500/20 relative overflow-hidden shadow-2xl">
  <div class="absolute -top-24 -right-24 w-60 h-60 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="relative z-10 max-w-xl mx-auto text-center mb-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 text-amber-400 text-xs font-semibold mb-3 border border-amber-500/20">
      <span>Özel Avantaj</span>
      <span class="w-1 h-1 rounded-full bg-amber-400"></span>
      <span>Erken Kayıt İndirimi</span>
    </div>
    <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-serif-art mb-3">
      Yeni Dönem İçin Yerinizi Ayırtın
    </h3>
    <p class="text-sm text-stone-300">
      Açılışa özel sınırlı kontenjanlı erken kayıt fırsatlarından yararlanmak ve ücretsiz tanışma dersi randevusu almak için formu doldurun veya doğrudan WhatsApp üzerinden bize ulaşın.
    </p>
  </div>

  <form id="lead-form" class="max-w-xl mx-auto space-y-4">
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <label for="fullName" class="block text-xs font-medium text-stone-300 mb-1.5">Adınız Soyadınız *</label>
        <input
          type="text"
          id="fullName"
          name="fullName"
          required
          placeholder="Örn: Ahmet Yılmaz"
          class="w-full px-4 py-3 rounded-xl bg-stone-900/90 border border-stone-800 text-stone-100 placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all text-sm"
        />
      </div>
      <div>
        <label for="phone" class="block text-xs font-medium text-stone-300 mb-1.5">Telefon Numaranız *</label>
        <input
          type="tel"
          id="phone"
          name="phone"
          required
          placeholder="Örn: 0555 123 45 67"
          class="w-full px-4 py-3 rounded-xl bg-stone-900/90 border border-stone-800 text-stone-100 placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all text-sm"
        />
      </div>
    </div>

    <div>
      <label for="interest" class="block text-xs font-medium text-stone-300 mb-1.5">İlgilendiğiniz Branş *</label>
      <select
        id="interest"
        name="interest"
        required
        class="w-full px-4 py-3 rounded-xl bg-stone-900/90 border border-stone-800 text-stone-100 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all text-sm"
      >
        <option value="" disabled selected>Branş Seçiniz...</option>
        <option value="Piyano">Piyano Eğitimi</option>
        <option value="Gitar">Gitar (Klasik / Akustik / Elektro)</option>
        <option value="Keman">Keman Eğitimi</option>
        <option value="Bağlama">Bağlama & THM</option>
        <option value="Şan">Şan & Ses Eğitimi</option>
        <option value="Karakalem">Karakalem & Temel Çizim</option>
        <option value="YagliBoya">Yağlı Boya & Akrilik Atölyesi</option>
        <option value="SinavHazirlik">Konservatuvar / Güzel Sanatlara Hazırlık</option>
        <option value="CocukAtolye">Çocuk Sanat & Ritim Atölyesi (4-12 Yaş)</option>
        <option value="Diger">Diğer / Kararsızım (Rehberlik İstiyorum)</option>
      </select>
    </div>

    <div>
      <label for="notes" class="block text-xs font-medium text-stone-300 mb-1.5">Varsa Notunuz / Yaş / Hedefleriniz</label>
      <textarea
        id="notes"
        name="notes"
        rows="2"
        placeholder="Örn: 7 yaşındaki kızım için piyano başlangıç eğitimi düşünüyoruz."
        class="w-full px-4 py-2.5 rounded-xl bg-stone-900/90 border border-stone-800 text-stone-100 placeholder-stone-500 focus:outline-none focus:ring-2 focus:ring-amber-500/50 focus:border-amber-500 transition-all text-sm"
      ></textarea>
    </div>

    <div class="pt-2 flex flex-col sm:flex-row gap-3">
      <button
        type="submit"
        class="flex-1 px-6 py-3.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-stone-950 font-bold text-sm tracking-wide shadow-lg shadow-amber-500/20 transition-all duration-300 flex items-center justify-center gap-2"
      >
        <span>Ön Kayıt Talebini Gönder</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </button>

      <a
        id="whatsapp-direct-btn"
        href={`https://wa.me/${defaultSiteSettings.whatsapp}?text=${encodeURIComponent('Merhaba Sevgi Sanat Evi, web sitenizden ulaşıyorum. Kurslar ve erken kayıt hakkında bilgi alabilir miyim?')}`}
        target="_blank"
        rel="noopener noreferrer"
        class="px-5 py-3.5 rounded-xl bg-emerald-500/10 hover:bg-emerald-500 text-emerald-400 hover:text-stone-950 border border-emerald-500/30 font-semibold text-sm transition-all duration-300 flex items-center justify-center gap-2"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766 0-3.18-2.587-5.771-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.861.174.086.275.072.376-.044.102-.115.434-.506.549-.68.116-.173.232-.144.39-.086.159.058 1.011.477 1.184.564.173.087.289.13.332.202.043.073.043.419-.101.824z"></path>
        </svg>
        <span>WhatsApp ile Yazın</span>
      </a>
    </div>

    <div id="form-feedback" class="hidden text-center text-sm font-medium py-3 px-4 rounded-xl"></div>
  </form>
</div>

<script is:inline define:vars={{ whatsappNumber: defaultSiteSettings.whatsapp }}>
  const form = document.getElementById('lead-form');
  const feedback = document.getElementById('form-feedback');

  if (form) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const fullName = document.getElementById('fullName').value.trim();
      const phone = document.getElementById('phone').value.trim();
      const interest = document.getElementById('interest').value;
      const notes = document.getElementById('notes').value.trim();

      const messageText = `Merhaba Sevgi Sanat Evi! Ben ${fullName}. Telefonum: ${phone}. İlgilendiğim Branş: ${interest}.${notes ? ' Not: ' + notes : ''}`;
      const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(messageText)}`;

      feedback.classList.remove('hidden', 'bg-red-900/50', 'text-red-300');
      feedback.classList.add('bg-emerald-900/50', 'text-emerald-300', 'border', 'border-emerald-500/30');
      feedback.textContent = 'Harika! Ön kayıt talebiniz hazırlandı. WhatsApp üzerinden mesaj aktarılıyor...';

      setTimeout(() => {
        window.open(whatsappUrl, '_blank');
      }, 1000);
    });
  }
</script>
