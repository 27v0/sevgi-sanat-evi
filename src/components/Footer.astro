---
import { defaultSiteSettings } from '../sanity/client';
---

<footer class="w-full border-t border-stone-800 bg-stone-950 text-stone-400 py-12 px-4 sm:px-6 lg:px-8 mt-24">
  <div class="max-w-7xl mx-auto grid grid-cols-1 md:grid-cols-4 gap-8 mb-12">
    <!-- Brand column -->
    <div class="md:col-span-2">
      <div class="flex items-center gap-3 mb-4">
        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-400 to-rose-500 p-0.5">
          <div class="w-full h-full bg-stone-950 rounded-[10px] flex items-center justify-center text-amber-400">
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 18V5l12-2v13"></path>
              <circle cx="6" cy="18" r="3"></circle>
              <circle cx="18" cy="16" r="3"></circle>
            </svg>
          </div>
        </div>
        <div>
          <span class="text-xl font-bold text-white font-serif-art">Sevgi Sanat Evi</span>
          <p class="text-xs text-amber-400 font-medium">Müzik & Resim Kursları</p>
        </div>
      </div>
      <p class="text-sm text-stone-400 max-w-md leading-relaxed mb-6">
        Her yaştan sanatsevere piyano, keman, gitar, bağlama, şan, karakalem ve yağlı boya eğitimleri sunan, Güzel Sanatlar Fakülteleri ve Konservatuvar yetenek sınavlarına hazırlayan sanat merkezimiz.
      </p>
      <div class="flex items-center gap-4 text-xs text-stone-500">
        <span>© {new Date().getFullYear()} Sevgi Sanat Evi. Tüm hakları saklıdır.</span>
      </div>
    </div>

    <!-- Quick Links -->
    <div>
      <h3 class="text-sm font-semibold text-stone-200 uppercase tracking-wider mb-4">Popüler Kurslar</h3>
      <ul class="space-y-2.5 text-sm">
        <li><a href="#kurslar" class="hover:text-amber-400 transition-colors">Piyano Eğitimi</a></li>
        <li><a href="#kurslar" class="hover:text-amber-400 transition-colors">Gitar (Klasik / Elektro)</a></li>
        <li><a href="#kurslar" class="hover:text-amber-400 transition-colors">Keman Eğitimi</a></li>
        <li><a href="#kurslar" class="hover:text-amber-400 transition-colors">Bağlama & THM</a></li>
        <li><a href="#kurslar" class="hover:text-amber-400 transition-colors">Karakalem & Resim</a></li>
        <li><a href="#kurslar" class="hover:text-amber-400 transition-colors">Konservatuvara Hazırlık</a></li>
      </ul>
    </div>

    <!-- Contact & Admin -->
    <div>
      <h3 class="text-sm font-semibold text-stone-200 uppercase tracking-wider mb-4">İletişim & Konum</h3>
      <ul class="space-y-3 text-sm">
        <li class="flex items-start gap-2.5">
          <svg class="w-4 h-4 text-amber-400 mt-1 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span>{defaultSiteSettings.address}</span>
        </li>
        <li class="flex items-center gap-2.5">
          <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          <a href={`tel:${defaultSiteSettings.phoneClean}`} class="hover:text-amber-400 transition-colors">{defaultSiteSettings.phone}</a>
        </li>
        <li class="flex items-center gap-2.5">
          <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
          <a href={`mailto:${defaultSiteSettings.email}`} class="hover:text-amber-400 transition-colors">{defaultSiteSettings.email}</a>
        </li>
        <li class="pt-2">
          <a
            href="/admin"
            class="inline-flex items-center gap-2 text-xs text-amber-400 hover:text-amber-300 transition-colors bg-stone-900 border border-stone-800 rounded-lg px-3 py-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
            <span>Sanity Admin Paneli Girişi</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</footer>
