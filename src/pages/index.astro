---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Sevgi Sanat Evi | Yakında Yayındayız"
  description="Sevgi Sanat Evi; müzik ve resim kursları ile çok yakında yayında."
>
  <main class="min-h-screen flex flex-col items-center justify-center p-6 text-center select-none">
    <div class="space-y-4 max-w-lg">
      <h1 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white font-serif-art">
        Sevgi Sanat Evi
      </h1>
      <p class="text-base sm:text-lg font-medium text-amber-400 tracking-wide">
        Yakında yayındayız.
      </p>
    </div>
  </main>
</Layout>
